<mujoco model="go2 known 5cm step">
  <include file="go2.xml"/>

  <statistic center="1.2 0 0.18" extent="1.8"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-16"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.12"/>
    <material name="step_surface" rgba="0.38 0.42 0.46 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Fixed full-width 5 cm up-step. Leading edge is x=0.80 m, top z=0.05 m.
         The plateau extends well beyond the evaluation window so success means
         getting the whole robot onto the raised surface, not merely hopping a bar. -->
    <geom name="known_step_5cm" pos="2.40 0 0.025" type="box"
      size="1.60 1.00 0.025" material="step_surface"
      contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
  </worldbody>
</mujoco>
